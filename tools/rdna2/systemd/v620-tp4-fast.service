[Unit]
Description=V620 verified TP4 Flash-Next with QSA bound, resident decode and checkpoints
Conflicts=v620-tp4-default.service v620-decode-qsa-candidate.service v620-prefill-improved.service v620-serve-intel.service v620-serve-intel-backup.service v620-enhanced-manual.service v620-pp4.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/george/v620-experiments/decode-qsa-20260920/source
Environment=VLLM_ROCM_MOE_PREFILL=0
Environment=VLLM_RDNA_MOE_RESIDENT=1
Environment=VLLM_RDNA_MOE_RESIDENT_SKINNY=1
Environment=VLLM_RDNA_FUSED_SE=1
Environment=VLLM_GDN_HIP_PREFILL=0
Environment=VLLM_TUNED_CONFIG_FOLDER=/home/george/v620-experiments/decode-qsa-20260920/tuned-moe
ExecStart=/bin/bash /home/george/v620-experiments/decode-qsa-20260920/source/tools/rdna2/serve_v620_tp4_fast.sh
Restart=on-failure
RestartSec=10s
KillMode=control-group
TimeoutStopSec=90s
MemoryMax=236223201280
MemorySwapMax=0
StandardOutput=append:/home/george/v620-experiments/decode-qsa-20260920/default-serve.log
StandardError=append:/home/george/v620-experiments/decode-qsa-20260920/default-serve.log

[Install]
WantedBy=default.target
