# Preserve the existing AutoRound serving configuration for a source-only A/B.
# MODEL, VENV, ROCM_SDK_ROOT and cache directories come from the caller.
SERVE_ENTRY=api
SERVED_NAME=active
HOST=127.0.0.1
PORT=8082
TP=4
PP=1
MTP=2
ATTN=fa
MAXLEN=262144
BLOCK_SIZE=1024
SEQS=4
MAXBAT=4096
LPTH=0
PREFILL_INTERVAL=1
KV=4026531840
COMPILE_MODE=3
CG_MODE=FULL_AND_PIECEWISE
CG_CAPTURE_SIZES=1
CG_SIZES='[3,6,12]'
CG_EXTRA=',"compile_ranges_endpoints":[]'
FEATURES="expert-parallel prefix-caching mamba-align vision-cap reasoning"
LIMIT_MM_PER_PROMPT='{"image":255,"video":32}'
MM_PROCESSOR_KWARGS='{"max_pixels":602112}'
EXTRA_ARGS='--pipeline-parallel-size 1 --enable-ep-weight-filter --kv-offloading-size 64 --enable-auto-tool-choice --tool-call-parser qwen3_xml --default-chat-template-kwargs {"enable_thinking":false} --kernel-config {"moe_backend":"triton"}'
PLE=bf16
W4A8=0
ALLOC_CONF=
TUNED_CONFIG=1
GPU_MAX_HW_QUEUES=2
ROCPROFILER_REGISTER_ENABLED=0
PYTORCH_ALLOC_CONF=pinned_max_round_threshold_mb:128
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_AOT_COMPILE=0
VLLM_GDN_HIP_PREFILL=0
VLLM_RDNA_FUSED_SE=1
VLLM_RDNA_HC_PREFILL_FUSED=2
VLLM_RDNA_MOE_RESIDENT=1
VLLM_RDNA_MOE_RESIDENT_SKINNY=1
VLLM_RDNA2_MOE_FP32_ACCUM=0
VLLM_RDNA_DENSE_INT8=0
VLLM_RDNA_DENSE_INT8_ONLY=0
VLLM_RDNA_DENSE_GEMV=0
VLLM_RDNA_AR=0
VLLM_RDNA_AR_MAX_KB=64
VLLM_RDNA_AR_ONESHOT_KB=64
VLLM_RDNA_AR_BLOCKS=0
VLLM_RDNA_AR_PACE=0
VLLM_FORCE_CUSTOM_ALL_REDUCE=0
VLLM_RDNA_DECODE_STALL_MS=0
VLLM_RDNA_DYNAMIC_PREFILL=0
VLLM_CAUSAL_CONV1D_RDNA2_FWD=0
VLLM_CAUSAL_CONV1D_RDNA2_UPDATE=0
VLLM_ENABLE_STARTUP_PLAN=0
HSA_FORCE_FINE_GRAIN_PCIE=1
HSA_ENABLE_SDMA=0
OMP_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
PYTHONFAULTHANDLER=1
